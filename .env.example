# ============================================================================
#  iPharmaLink :: environment template
# ---------------------------------------------------------------------------
#  Copy this file to `.env` and fill in your own values.
#  `.env` must NEVER be committed to version control.
# ============================================================================

# ---- Application -------------------------------------------------------------
APP_NAME="iPharmaLink"
APP_ENV=production              # local | production
APP_DEBUG=false                 # true shows raw errors — local development only
APP_URL=http://localhost:8000   # no trailing slash
APP_TIMEZONE=Africa/Lagos
APP_CURRENCY=NGN

# Generate a unique key:  php -r "echo bin2hex(random_bytes(32));"
# Used for payment webhook HMAC verification and encrypted settings at rest.
# Without it the payment webhooks will refuse to validate.
APP_KEY=

# ---- Database (MySQL 8+ / MariaDB 10.4+) ------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ipharmalink
DB_USERNAME=root
DB_PASSWORD=

# ---- Session & security ------------------------------------------------------
SESSION_NAME=ipharmalink_sid
SESSION_LIFETIME=3600   # idle timeout in seconds
SESSION_SECURE=auto      # auto = cookies only sent over HTTPS
SESSION_DOMAIN=

# ---- Payment gateways --------------------------------------------------------
# Credentials may also be entered in the admin panel under
# Settings → Payment Settings, which is usually easier for non-technical staff.
# Add your gateway's webhook URL to the gateway dashboard:
#   Paystack        https://your-domain.example/webhooks/paystack
#   Flutterwave     https://your-domain.example/webhooks/flutterwave

# Paystack — https://dashboard.paystack.com/#/settings/developers
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=

# Flutterwave — https://developer.flutterwave.com
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxx-X
FLW_HASH_SECRET=

# ---- Email (SMTP) ------------------------------------------------------------
# MAIL_DRIVER=log writes emails to storage/logs/mail.log instead of sending —
# the safest setting for a fresh install.
MAIL_DRIVER=log                # log | smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=no-reply@your-domain.example
MAIL_FROM_NAME=iPharmaLink

# ---- SMS (optional) ----------------------------------------------------------
# Provider credentials go here; Termii, BulkSMS and Arkesel are all supported.
SMS_DRIVER=log                 # log | termii | bulksms | arkesel
SMS_API_KEY=
SMS_SENDER_ID=iPharmaLink
