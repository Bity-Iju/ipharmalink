# ============================================================================
#  iPharmaLink :: Apache configuration
#  Clean URLs + security hardening
# ============================================================================

# ---- Front controller -------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (uncomment in production behind TLS)
    # RewriteCond %{HTTPS} !=on
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block direct access to application internals
    RewriteRule ^(config|includes|database|storage|components|templates)/ - [F,L]
    RewriteRule ^(bootstrap\.php|composer\.(json|lock)|\.(env|htaccess|gitignore)) - [F,L]

    # Existing files and directories are served as-is (assets, uploads)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else goes through the router
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ---- Document root protection ----------------------------------------------
<FilesMatch "\.(sql|log|md|json|lock|ini|env)$">
    Require all denied
</FilesMatch>

# ---- Security headers -------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
    Header unset X-Powered-By
</IfModule>

# ---- Compression & caching --------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg            "access plus 6 months"
    ExpiresByType image/png             "access plus 6 months"
    ExpiresByType image/webp            "access plus 6 months"
    ExpiresByType image/svg+xml         "access plus 6 months"
    ExpiresByType text/html             "access plus 0 seconds"
</IfModule>

DirectoryIndex index.php
Options -Indexes
